{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "releaseready-guardrails.json",
  "description": "Repo settings for releaseready-guardrails. Every exception carries a reason a reviewer can check.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "allow": {
      "description": "Findings that are correct here. Each entry names the rule, a path glob, optionally a substring of the offending line, and why (for legacy code: the current consumer). Entries that match nothing are errors.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "path", "reason"],
        "properties": {
          "rule": {
            "enum": [
              "dependency-source",
              "unpublished-internal-dependency",
              "tsconfig-private-path",
              "tsconfig-not-strict",
              "build-in-node-modules",
              "copied-schema-primitive",
              "copied-canonical-digest",
              "copied-jwt-verifier",
              "hand-written-archive-parser",
              "copied-wcag-contrast",
              "legacy-marker",
              "skipped-test",
              "hardcoded-tmp",
              "eslint-rule-off-without-reason",
              "readme-dated-history",
              "tracked-ds-store",
              "tracked-build-output",
              "oversized-source-file",
              "suppression-without-reason",
              "argv-index"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "match": { "type": "string", "minLength": 3 },
          "max": { "type": "integer", "minimum": 1 },
          "reason": {
            "type": "string",
            "minLength": 20,
            "not": {
              "pattern": "^(TODO|[Tt]odo|TBD|[Pp]re-?existing|[Bb]aseline)\\b"
            }
          }
        }
      }
    },
    "jscpd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
        "reason": { "type": "string", "minLength": 20 },
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "ignore": { "type": "array", "items": { "type": "string" } }
      },
      "if": {
        "required": ["threshold"],
        "properties": {
          "threshold": { "type": "number", "exclusiveMinimum": 3 }
        }
      },
      "then": { "required": ["reason"] }
    },
    "fileLength": {
      "description": "oversized-source-file settings. A limit above 1000 lines needs a reason; every generated-file glob names why the file is generated.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLines": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 20 },
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": {
                "type": "string",
                "minLength": 20,
                "not": {
                  "pattern": "^(TODO|[Tt]odo|TBD|[Pp]re-?existing|[Bb]aseline)\\b"
                }
              }
            }
          }
        }
      },
      "if": {
        "required": ["maxLines"],
        "properties": {
          "maxLines": { "type": "integer", "exclusiveMinimum": 1000 }
        }
      },
      "then": { "required": ["reason"] }
    },
    "knip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 20 },
        "args": { "type": "array", "items": { "type": "string" } }
      },
      "if": {
        "required": ["enabled"],
        "properties": { "enabled": { "type": "boolean", "const": false } }
      },
      "then": { "required": ["reason"] }
    }
  }
}
